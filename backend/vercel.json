{
  "version": 2,
  "builds": [
    {
      "src": "src/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/cron/scan-lives",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/cron/renew-yt-subs",
      "schedule": "0 6 * * *"
    }
  ]
}
